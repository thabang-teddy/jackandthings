# Copy to .env (local) or ~/jackandthings.env (server). NEVER commit the real file.
DJANGO_SECRET_KEY=
ADMIN_URL=admin-local
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
# Production only:
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
SECURE_HSTS_SECONDS=3600
PRIVATE_MEDIA_ROOT=
LOG_DIR=
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=true
DEFAULT_FROM_EMAIL=
ADMINS_EMAIL=
# Stage 16: the browser extension's origin, e.g. chrome-extension://abcdefghijklmnop
EXTENSION_ORIGIN=
