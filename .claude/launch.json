{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "laravel",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "cd /d laravel && php artisan serve --port=8010"],
      "port": 8010
    },
    {
      "name": "django-vite",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "cd /d django\\frontend && npm run dev"],
      "port": 5173
    },
    {
      "name": "django",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "cd /d django && .venv\\Scripts\\python.exe manage.py runserver 8000"],
      "port": 8000
    }
  ]
}
