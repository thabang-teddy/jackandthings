<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked for at runtime on API 33+; covers both the hourly workout nudge
         and the running-Pomodoro notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- For PomodoroTimerService, so the countdown and its notification
         controls survive the app being backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".JackApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.JackAndThings">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets the app receive text from Android's share sheet, which is
                 how a snippet gets into Clipboard from another app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- No existing android:foregroundServiceType category fits a focus
             timer; specialUse is the documented escape hatch for exactly that,
             declared below with the required PROPERTY_SPECIAL_USE_FGS_SUBTYPE. -->
        <service
            android:name=".pomodoro.PomodoroTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="pomodoro-timer" />
        </service>
    </application>

</manifest>
