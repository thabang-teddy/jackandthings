<?xml version="1.0" encoding="utf-8"?>
<!-- Brand gradient: accent (#2B6CFF) to glow (#17D9D4), the same pair the web
     shell uses in laravel/resources/js/Lib/themeTokens.js. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:offset="0"
                    android:color="#FF2B6CFF" />
                <item
                    android:offset="1"
                    android:color="#FF17D9D4" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
