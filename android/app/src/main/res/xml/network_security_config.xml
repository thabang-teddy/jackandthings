<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext is off everywhere by default. The two exceptions are the loopback
    addresses a local Laravel dev server listens on - 10.0.2.2 is the host
    machine as seen from the emulator - so development works without opening
    plain HTTP to the internet at large.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
