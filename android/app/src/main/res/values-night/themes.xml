<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The dark counterpart of values/themes.xml, and nothing more: Compose
        repaints the bars from the chosen appearance on the first frame
        (JackTheme -> MatchSystemBars), so this only stops the window flashing
        light while a phone in dark mode is still starting. An in-app choice of
        Light on a dark phone will show this dark window for that instant.
    -->
    <style name="Theme.JackAndThings" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/brand_surface_dark</item>
        <item name="android:navigationBarColor">@color/brand_surface_dark</item>
    </style>
</resources>
