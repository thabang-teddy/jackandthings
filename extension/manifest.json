{
  "manifest_version": 3,
  "name": "Jack & Things",
  "version": "0.1.0",
  "description": "Pomodoro, notes, budget, workout, clipboard and browsing-history clean-up, against your own Jack & Things server.",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Jack & Things",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module",
    "scripts": ["src/background/service-worker.js"]
  },

  "permissions": ["storage", "alarms", "notifications"],

  "optional_permissions": ["history", "clipboardRead"],

  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],

  "optional_host_permissions": ["*://*/*"],

  "browser_specific_settings": {
    "gecko": {
      "id": "jackandthings@localhost",
      "strict_min_version": "121.0"
    }
  }
}
